# Your Anthropic API key. Create one at https://console.anthropic.com/settings/keys
# This is read by the API server only - it is never sent to the browser.
# Do not add a VITE_ prefix: Vite inlines VITE_* variables into the client bundle.
ANTHROPIC_API_KEY=sk-ant-...

# Optional overrides
# ANTHROPIC_MODEL=claude-opus-5
# PORT=8787
